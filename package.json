	},
	"dependencies": {
		"@kea/dtypes": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"electron": "^43.1.1",
		"react": "^19.2.8",
		"tsdown": "^0.22.13",
		"typescript": "^7.0.2",
		"unrun": "^0.3.1"
	}
}
