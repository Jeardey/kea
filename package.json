{
	"name": "kea",
	"description": "da KEWLEST discord mod (not a lie)",
	"author": "mesanets",
	"license": "GPL-3.0-only",
	"version": "1.0.0",
	"main": "dist/inject.js",
	"scripts": {
		"build": "tsdown",
		"inject": "pnpm build && node dist/install.js",
		"lint:check": "biome check .",
		"lint:format": "echo 'currently disabled'",
